{
  "name": "flashwork",
  "private": true,
  "version": "0.2.0",
  "description": "Flashwork — local-first AI agent orchestrator (Tauri).",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "pnpm --prefix apps/orchestrator install",
    "dev": "pnpm --prefix apps/orchestrator run app",
    "dev:ui": "pnpm --prefix apps/orchestrator run dev",
    "test": "pnpm --prefix apps/orchestrator test",
    "test:local": "pnpm run setup && pnpm run lint && pnpm run test && pnpm --prefix apps/orchestrator run build",
    "lint": "pnpm --prefix apps/orchestrator run lint",
    "installer": "pnpm --prefix apps/orchestrator run installer",
    "installer:linux": "pnpm --prefix apps/orchestrator run installer:linux",
    "installer:macos": "pnpm --prefix apps/orchestrator run installer:macos",
    "installer:windows": "pnpm --prefix apps/orchestrator run installer:windows",
    "build": "pnpm run installer"
  }
}
